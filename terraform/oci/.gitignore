# Terraform state and cache
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Sensitive files
terraform.tfvars
*.auto.tfvars

# WireGuard keys (generated by module)
**/.keys/
*.key

# Crash logs
crash.log
crash.*.log

# The provider lock file is tracked for this root (terraform/.gitignore ignores it).
!.terraform.lock.hcl
