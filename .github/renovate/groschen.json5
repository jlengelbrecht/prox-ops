{
  // Self-hosted config for renovate-groschen.yaml. Repository config is ignored
  // so its shared queue limits and presets cannot override this pass.
  requireConfig: 'ignored',
  onboarding: false,
  dependencyDashboard: false,
  enabledManagers: ['kubernetes'],
  includePaths: ['kubernetes/apps/groschen/app/deployment.yaml'],
  kubernetes: {
    managerFilePatterns: ['kubernetes/apps/groschen/app/deployment.yaml'],
  },
  prConcurrentLimit: 0,
  branchConcurrentLimit: 0,
  prHourlyLimit: 0,
  commitHourlyLimit: 0,
  platformAutomerge: true,
  packageRules: [
    {
      description: 'Exclude every Kubernetes dependency unless explicitly allowed below',
      matchManagers: ['kubernetes'],
      enabled: false,
      automerge: false,
    },
    {
      description: 'Allow only the production Groschen main image through lookup',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/jlengelbrecht/groschen'],
      matchFileNames: ['kubernetes/apps/groschen/app/deployment.yaml'],
      matchCurrentValue: 'main',
      enabled: true,
      allowedVersions: '/^main$/',
      pinDigests: true,
      groupName: 'Groschen image',
      groupSlug: 'groschen-image',
    },
    {
      description: 'Reject non-digest updates after lookup',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/jlengelbrecht/groschen'],
      matchFileNames: ['kubernetes/apps/groschen/app/deployment.yaml'],
      matchCurrentValue: 'main',
      matchUpdateTypes: ['!/^(digest|pinDigest)$/'],
      enabled: false,
      automerge: false,
    },
    {
      description: 'Update only the paired Groschen main digests after required CI',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/jlengelbrecht/groschen'],
      matchFileNames: ['kubernetes/apps/groschen/app/deployment.yaml'],
      matchUpdateTypes: ['digest', 'pinDigest'],
      matchCurrentValue: 'main',
      enabled: true,
      automerge: true,
      automergeType: 'pr',
      ignoreTests: false,
      platformAutomerge: true,
      minimumReleaseAge: '0',
    },
  ],
}
