{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 1: DIGEST AUTOMERGE - Safe container rebuilds (no version change)
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Auto-merge container digests for vetted official images",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": [
        // Core infrastructure
        "ghcr.io/home-assistant/home-assistant",
        "ghcr.io/controlplaneio-fluxcd/flux-operator",
        "ghcr.io/controlplaneio-fluxcd/flux-instance",
        "docker.io/cloudflare/cloudflared",
        "ghcr.io/coredns/coredns",
        "mirror.gcr.io/coredns/coredns"
      ]
    },
    {
      "description": "Auto-merge container digests for trusted maintainers",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": true,
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": [
        // VPN/Network
        "ghcr.io/qdm12/gluetun",
        // System utilities
        "ghcr.io/spegel-org/spegel",
        "ghcr.io/stakater/reloader",
        "ghcr.io/k8snetworkplumbingwg/multus-cni",
        "ghcr.io/kashalls/external-dns-unifi-webhook",
        // Media sidecars
        "ghcr.io/onedr0p/exportarr"
      ]
    },
    {
      "description": "Auto-merge GitHub Actions digest updates",
      "matchDatasources": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["digest"],
      "ignoreTests": true
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // DEFAULT POSTURE: broad auto-merge (denylist model)
    // Auto-merge patch + minor for ALL packages by default, after a soak window.
    // Placed FIRST so the specific Tier-2 soak refinements below (e.g. gluetun 5d,
    // critical-infra 5d, github-actions 1d) and the Tier-3/Tier-4 force-manual
    // rules both override it where needed. ALL major updates always remain manual.
    // Digests stay opt-in (Tier 1 above).
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Default: auto-merge patch updates after a 3-day soak (non-critical packages; later tiers override)",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Default: auto-merge minor updates after a 5-day soak (non-critical packages; later tiers override)",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Global safety net: ALL major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 2: PATCH AUTOMERGE - Stable apps with release age wait
    // Bug fixes only, community-tested before automerge
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Auto-merge LinuxServer.io media app patches (3 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": [
        "/lscr.io/linuxserver/.*/",
        "/ghcr.io/linuxserver/.*/"
      ]
    },
    {
      "description": "Auto-merge Gluetun patches (5 day wait for VPN caution)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "5 days",
      "matchPackageNames": ["ghcr.io/qdm12/gluetun"]
    },
    {
      "description": "Auto-merge media utility patches (3 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": [
        "ghcr.io/cleanuparr/cleanuparr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/wizarrrr/wizarr",
        "golift/notifiarr",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/gethomepage/homepage"
      ]
    },
    {
      "description": "Auto-merge patch updates for stable system charts",
      "matchDatasources": ["helm"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "matchPackageNames": [
        "cert-manager",
        "external-secrets",
        "metrics-server",
        "reloader",
        "spegel"
      ]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 2b: CRITICAL INFRA PATCH (5-day soak)
    // cert-manager, cilium, external-secrets, cloudnative-pg: patch-only
    // automerge with 5-day soak. Minor + major remain manual via Tier-3.
    // Note: envoy-gateway and kube-prometheus-stack are NOT here — owner
    // decision: no automerge at all for those (fully manual via Tier-3).
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Auto-merge critical infra PATCH updates (5 day soak) — cert-manager, cilium, external-secrets, cloudnative-pg",
      "matchDatasources": ["docker", "helm"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "5 days",
      "matchPackageNames": [
        "/cert-manager/",
        "/cilium/",
        "/external-secrets/",
        "/cloudnative-pg/"
      ]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 2c: APP-TEMPLATE (bjw-s) — patch + minor automerge
    // Chart is a scaffold only; its version does not change running container
    // images. Minor bumps add optional new features (safe after 5d soak).
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Auto-merge app-template (bjw-s) patch updates (3 day soak)",
      "matchDatasources": ["helm"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": ["app-template"]
    },
    {
      "description": "Auto-merge app-template (bjw-s) minor updates (5 day soak)",
      "matchDatasources": ["helm"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "5 days",
      "matchPackageNames": ["app-template"]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 2d: STATELESS APP MINOR AUTOMERGE (5-day soak)
    // LinuxServer/*arr apps, media utilities, cloudflared, Home Assistant
    // patches, GitHub Actions, CLI tools (mise), Terraform providers, ARC runners.
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Auto-merge LinuxServer.io media app minor updates (5 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "5 days",
      "matchPackageNames": [
        "/lscr.io/linuxserver/.*/",
        "/ghcr.io/linuxserver/.*/"
      ]
    },
    {
      "description": "Auto-merge media utility app minor updates (5 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "5 days",
      "matchPackageNames": [
        "ghcr.io/cleanuparr/cleanuparr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/wizarrrr/wizarr",
        "golift/notifiarr",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/gethomepage/homepage"
      ]
    },
    {
      "description": "Auto-merge Home Assistant patch updates (3 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant"]
    },
    {
      "description": "Auto-merge cloudflared patch updates (3 day wait)",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": [
        "docker.io/cloudflare/cloudflared",
        "cloudflare/cloudflared"
      ]
    },
    {
      "description": "Auto-merge glycemicgpt (owner-maintained app) digest/patch/minor updates with no soak — owner controls release cadence",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "minimumReleaseAge": "0",
      // Scope to the trusted GHCR namespace only (ghcr.io/lumose-health/*: discord-bot,
      // glycemicgpt-api/-web/-sidecar). A bare "/lumose-health/" substring would also
      // auto-merge a like-named image in any other namespace. Major bumps still fall
      // through to manual review (not listed here).
      "matchPackageNames": ["/^ghcr\\.io\\/lumose-health\\/.+/"]
    },
    {
      "description": "Auto-merge GitHub Actions patch and minor updates (1 day wait; SHA-pinned by helpers:pinGitHubActionDigests)",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge CLI tools patch and minor updates (1 day wait; mise-managed, no cluster impact until used)",
      "matchManagers": ["mise"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge Terraform provider patch and minor updates (1 day wait; no cluster impact until apply)",
      "matchDatasources": ["terraform-provider"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch", "minor"],
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Auto-merge ARC runner chart patch updates (3 day wait; ephemeral runners, stateless)",
      "matchDatasources": ["helm"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "matchPackageNames": ["/actions-runner/", "/gha-runner/"]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 2e: MEDIA / REQUEST / DOWNLOAD APPS - patch + minor automerge, short soak
    // Stateless apps get the shortest soak (1 day patch, 3 days minor) and a higher
    // prPriority so they are created and rebased ahead of manual-review PRs. The soak
    // only bites where the registry reports a release timestamp (Docker Hub); see
    // minimumReleaseAgeBehaviour in renovate.json5. Majors stay manual.
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "Media apps: auto-merge patch updates after a 1 day soak; tolerate registries with no release timestamp",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "1 day",
      "prPriority": 5,
      "matchPackageNames": [
        "lscr.io/linuxserver/plex",
        "lscr.io/linuxserver/tautulli",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/sabnzbd",
        "lscr.io/linuxserver/qbittorrent",
        "ghcr.io/linuxserver/bookstack",
        "ghcr.io/martabal/qbittorrent-exporter",
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/wizarrrr/wizarr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/cleanuparr/cleanuparr",
        "golift/notifiarr",
        "ghcr.io/gethomepage/homepage",
        "revenz/fileflows"
      ]
    },
    {
      "description": "Media apps: auto-merge minor updates after a 3 day soak; tolerate registries with no release timestamp",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "3 days",
      "prPriority": 5,
      "matchPackageNames": [
        "lscr.io/linuxserver/plex",
        "lscr.io/linuxserver/tautulli",
        "lscr.io/linuxserver/sonarr",
        "lscr.io/linuxserver/radarr",
        "lscr.io/linuxserver/prowlarr",
        "lscr.io/linuxserver/sabnzbd",
        "lscr.io/linuxserver/qbittorrent",
        "ghcr.io/linuxserver/bookstack",
        "ghcr.io/martabal/qbittorrent-exporter",
        "ghcr.io/onedr0p/exportarr",
        "ghcr.io/seerr-team/seerr",
        "ghcr.io/wizarrrr/wizarr",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/cleanuparr/cleanuparr",
        "golift/notifiarr",
        "ghcr.io/gethomepage/homepage",
        "revenz/fileflows"
      ]
    },
    {
      // FileFlows tags are modded-YY.MM and the versioning regex reads YY as "major", so
      // the January roll-over (modded-26.12 -> modded-27.01) would otherwise be a manual
      // major. It is an ordinary monthly release, so treat it like a minor.
      "description": "FileFlows: auto-merge the YY roll-over (reads as a major) after a 3 day soak",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "3 days",
      "prPriority": 5,
      "matchPackageNames": ["revenz/fileflows"]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 3: REQUIRE MANUAL REVIEW — Critical infrastructure + stateful apps
    //
    // MUST come AFTER all automerge opt-in rules so they take final precedence.
    //
    // Policy: patch updates auto-merge for core infrastructure after a long soak
    // (soak lengths are set by the last packageRules in renovate.json5); minor and
    // major open a PR for the PM and never auto-merge. Only the packages below stay
    // FULLY manual, each for a specific reason:
    //
    //   rook / ceph         — OSD corruption / PG rebalancing risk and CSI drivers
    //                         that failed during a past network disruption; a patch
    //                         can restart storage daemons, so a human picks the window
    //   generic-device-plugin, yubihsm-tools — privileged path to the YubiHSM
    //   agentgateway        — v1alpha1 CRDs with breaking changes on a monthly cadence
    //   hermes, hindsight   — image and chart move in lockstep with forward-only
    //                         migrations on the shared database
    //   paperclip, loki/promtail/alloy, crossplane — see their rules below
    //
    // Core packages that auto-merge PATCH only (minor/major are manual):
    //   authentik, nvidia (device plugin / DCGM), envoy-gateway,
    //   kube-prometheus-stack, cert-manager, cilium, external-secrets,
    //   cloudnative-pg, flux, coredns, multus, postgres/valkey/mariadb
    //
    // Reasons patch is acceptable: these are bug and CVE fixes, the required
    // checks run a full Flux render, and an outdated core component is itself a
    // vulnerability. Reasons minor is not: CRD or schema changes, restarts, and
    // behaviour changes that need a human to read the release notes.
    //
    // Older notes kept for reference:
    //   cert-manager          — patch OK (Tier-2b); minor/major manual
    //   cilium                — patch OK (Tier-2b); minor/major manual
    //   external-secrets      — patch OK (Tier-2b); minor/major manual
    //   cloudnative-pg        — patch OK (Tier-2b); minor/major manual
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "FULLY MANUAL: rook-ceph and Ceph — no automerge for any update type (data integrity risk, OSD corruption risk)",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchPackageNames": [
        "/rook/",
        "/ceph/"
      ]
    },
    {
      "description": "authentik and goauthentik: minor and major are manual (SSO lockout risk); patch auto-merges after a 7 day soak",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/authentik/",
        "/goauthentik/"
      ]
    },
    {
      "description": "NVIDIA device plugin / DCGM: minor and major are manual (Talos kernel and schematic coupling); patch auto-merges after a 7 day soak. Drivers live in the Talos schematic, not here.",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/nvidia/",
        "/nvidia-device-plugin/"
      ]
    },
    {
      "description": "FULLY MANUAL: generic-device-plugin - privileged DaemonSet that hands out the YubiHSM; read every release before merging",
      "matchDatasources": ["docker"],
      "automerge": false,
      "matchPackageNames": [
        "ghcr.io/squat/generic-device-plugin"
      ]
    },
    {
      "description": "FULLY MANUAL: yubihsm-tools base image - the image that sets up and signs with the YubiHSM; review every bump",
      "automerge": false,
      "matchFileNames": ["services/yubihsm-tools/**"]
    },
    {
      "description": "kube-prometheus-stack: minor and major are manual (CRD migrations, multi-component bundle); patch auto-merges after a 5 day soak",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "kube-prometheus-stack"
      ]
    },
    {
      "description": "envoy-gateway: minor and major are manual (ingress plane); patch auto-merges after a 7 day soak because patch releases carry CVE fixes",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/envoy-gateway/",
        "/envoyproxy/"
      ]
    },
    {
      "description": "FULLY MANUAL: agentgateway — no automerge for any update type (all CRDs are v1alpha1 with real breaking changes on a monthly cadence; version pin is load-bearing on the cluster's Gateway API CRD version, see WI-034-1-version-decision.md — every bump needs a release-note read before merge, not just a soak window)",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchPackageNames": [
        "/agentgateway/"
      ]
    },
    {
      "description": "Require manual review for critical-infra minor and major (cert-manager, cilium, external-secrets, cloudnative-pg)",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/cert-manager/",
        "/cilium/",
        "/external-secrets/",
        "/cloudnative-pg/"
      ]
    },
    {
      "description": "FULLY MANUAL minor/major: critical cluster infra (Flux, CoreDNS, Multus) — control-plane / DNS / CNI. Patch still auto-merges via the default soak; minor/major need eyes (a bad reconcile/DNS/CNI update can take the cluster down).",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/flux-operator/",
        "/flux-instance/",
        "/coredns/",
        "/multus/"
      ]
    },
    {
      "description": "FULLY MANUAL minor/major: stateful data layer (Postgres, Valkey/Redis, MariaDB) — minor bumps can trigger restarts/migrations that need a maintenance window. Patch still auto-merges via the default soak.",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/postgresql/",
        "/postgres/",
        "/valkey/",
        "/redis/",
        "/mariadb/"
      ]
    },

    // ═══════════════════════════════════════════════════════════════════════════
    // TIER 4: SPECIAL HANDLING — AI apps, Talos
    // ═══════════════════════════════════════════════════════════════════════════
    {
      "description": "AI apps that run database or storage migrations (litellm, open-webui, qdrant): minor and major are manual, patch auto-merges after a 5 day soak. ollama and lightrag use the normal app tier.",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchUpdateTypes": ["minor", "major"],
      "matchPackageNames": [
        "/litellm/",
        "/open-webui/",
        "/qdrant/"
      ]
    },
    {
      "description": "FULLY MANUAL: Hermes agent - the dashboard/config schema (_config_version) moves with the image and the chart is pinned to it; read the release notes and bump both together. Hindsight (api, control plane, chart) - migrations are forward-only on the shared CloudNativePG cluster, take a pg_dump -d hindsight first",
      "matchDatasources": ["docker", "helm"],
      "automerge": false,
      "matchPackageNames": [
        "docker.io/nousresearch/hermes-agent",
        "hermes-agent",
        "ghcr.io/vectorize-io/hindsight-api",
        "ghcr.io/vectorize-io/hindsight-control-plane",
        "hindsight"
      ]
    },
    // NOTE: Talos talenv.yaml (ghcr.io/siderolabs/installer) updates are disabled in
    // renovate.json5 ("Disable Talos updates (managed via Terraform)"), so talenv-based
    // rules would be dead. Talos auto-updates flow via terraform/variables.tf (below);
    // keeping talenv.yaml in sync is the upgrade workflow's job (EPIC-033 STORY-033-3).
    {
      "description": "Auto-merge Talos PETS upgrades (patch versions in Terraform, 5 day wait: a merge starts an in-place node upgrade)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["siderolabs/talos"],
      "matchFileNames": ["terraform/variables.tf", "terraform/terraform.tfvars"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "minimumReleaseAge": "5 days",
      "prBodyNotes": [
        "**Talos PETS**: Patch version will be auto-merged after 5-day stabilization. In-place upgrade via talosctl."
      ]
    },
    {
      "description": "Require manual review for Talos CATTLE upgrades (major/minor in Terraform)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["siderolabs/talos"],
      "matchFileNames": ["terraform/variables.tf", "terraform/terraform.tfvars"],
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false,
      "prBodyNotes": [
        "**Talos CATTLE**: Major/minor version requires manual approval. Full VM rebuild via Terraform."
      ]
    },
    // Paperclip: last in the list so no earlier patch/minor rule can auto-merge it.
    // No minimumReleaseAge: GHCR tags carry no release timestamp, so an age gate
    // would block every PR under timestamp-required; the manual merge is the gate.
    {
      "description": "FULLY MANUAL: Paperclip - migrations run forward-only at boot on the shared CloudNativePG cluster (no backups): take a pg_dump -d paperclip first. The image also re-pulls the bundled agent CLIs (claude-code, codex, opencode, gemini, kimi) at @latest each build, so any bump can change agent behaviour. Stable CalVer tags only (e.g. 2026.916.1); nightly, beta, canary, sha-* and the retired -cloud tags are excluded.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/paperclipai/paperclip"],
      "allowedVersions": "/^\\d{4}\\.\\d{3,4}\\.\\d+$/",
      "automerge": false,
      "prBodyNotes": [
        "**Paperclip**: manual merge. Before merging, `pg_dump -d paperclip` from the shared cluster and read the release notes (bundled agent CLIs move with the image)."
      ]
    },
    // Logging: after every patch/minor/digest opt-in so none of them can auto-merge it.
    {
      "description": "FULLY MANUAL: Loki, Promtail and Alloy - an update can change the log sanitizer or replace Loki storage, and the logging fixture is path-filtered rather than a required check",
      "matchDatasources": ["docker", "helm", "github-release-attachments"],
      "matchPackageNames": [
        "loki", "promtail", "alloy",
        "grafana/loki", "grafana/promtail", "grafana/alloy",
        "docker.io/grafana/loki", "docker.io/grafana/promtail", "docker.io/grafana/alloy"
      ],
      "automerge": false
    },
    {
      "description": "FULLY MANUAL: the logging fixture's pinned Alloy binary and chart move only with the deployed image and chart",
      "matchFileNames": ["scripts/hindsight-logging-ci-assets.py"],
      "automerge": false
    },
    // kube-prometheus-stack HelmRelease pins no image today; last so no opt-in can auto-merge one pinned later.
    {
      "description": "FULLY MANUAL: any container image later pinned in the kube-prometheus-stack HelmRelease (none today; the chart supplies them) - an image bump can migrate the Grafana database or Prometheus storage",
      "matchFileNames": ["kubernetes/apps/observability/kube-prometheus-stack/app/helmrelease.yaml"],
      "matchDatasources": ["docker"],
      "automerge": false
    },
    // Crossplane and provider-azuread: last so no patch/minor/digest opt-in can
    // auto-merge them. The provider holds write access to the Entra tenant and its
    // package is unsigned with no attestations, so every release soaks 7 days and
    // merges by hand after review. Provider.spec.package stays pinned by tag and
    // digest; the custom manager in customManagers.json5 moves both together.
    // No matchDatasources: this covers the helm chart, the custom-manager docker
    // dependency, and any Crossplane image or ImageConfig pinned later.
    {
      "description": "FULLY MANUAL: Crossplane chart and provider-azuread package - 7-day soak, never auto-merged, digest pin kept",
      "matchPackageNames": ["/crossplane/", "/provider-azuread/"],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "pinDigests": true,
      "prBodyNotes": [
        "**Crossplane / provider-azuread**: manual merge, no auto-merge. The provider package is unsigned: check that the new tag was published by the upstream release workflow and that the digest in this PR matches the run's output. Merge only after flux-local, CI and a security review pass."
      ]
    },
    {
      "description": "provider-azuread: a digest change under an existing tag is a re-tagged release - manual, and treated as a supply-chain event",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["kubernetes/apps/crossplane-system/provider-azuread/app/provider.yaml"],
      "matchUpdateTypes": ["digest"],
      "automerge": false,
      "prBodyNotes": [
        "**provider-azuread re-tag**: the tag did not change but its digest did. Do not merge until upstream explains the re-publish."
      ]
    }
  ]
}
