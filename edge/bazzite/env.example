# Template for the Bazzite edge worker's untracked host config — copied to
# ~/.config/edge-bazzite/edge.env by the bring-up (README.md), read by the
# systemd user units via EnvironmentFile=, and by scripts/install.sh when it
# renders the quadlet from systemd/edge-llama-swap.container.template.
#
#   cp env.example .env && chmod 600 .env    # edit, then install per README
#
# Nothing secret lives in this file even after you fill it in: the bearer
# credential is a *path* (EDGE_API_KEY_FILE, stated by the units and the
# quadlet, not here), and the TLS key never leaves the PKI directory. The one
# thing that is merely private rather than secret is the LAN address, which is
# why it is here and not in any tracked file — edge/ is gate-checked for
# literal addresses.

# --- identity ---------------------------------------------------------------

# The catalog placement name. A public identifier: it appears as an
# agentgateway provider `name` and as the value of the x-placement header,
# and renaming one is a breaking change (frozen by 35.5).
EDGE_NODE_ID=bazzite-5090

# DNS name the cluster reaches this host by, and the leaf certificate's only
# SAN. Use a name, never an address. Published through unifi-dns
# (DNSEndpoint) once the control-plane change lands; until then every client
# pins it with --resolve / EDGE_CURL_RESOLVE.
EDGE_HOSTNAME=bazzite-5090.homelab0.org

# Address and port the endpoint is published on. Bind the specific LAN
# address rather than 0.0.0.0 so the endpoint does not also appear on other
# interfaces. RFC 5737 placeholder — replace with this host's LAN address.
EDGE_BIND_ADDR=192.0.2.10
EDGE_PORT=8443

# What the heartbeat advertises as runtime.endpoint. Observational metadata
# only — it is never a routing target and never reconfigures the gateway.
EDGE_ENDPOINT=https://bazzite-5090.homelab0.org:8443

# --- image ------------------------------------------------------------------

# Built from ./Containerfile with rootless podman: llama.cpp's CUDA server
# image plus the llama-swap release binary. The llama.cpp build number
# matches the image the cluster's kserve-a5000 placement runs.
EDGE_IMAGE=localhost/edge-llama-swap:b9917-swap250
EDGE_LLAMACPP_BUILD=b9917

# --- storage ----------------------------------------------------------------
# Host DIRECTORIES, not container-runtime volumes: rootless podman gives the
# login user direct ownership of everything, so plain directories are both
# simpler and backup-friendly. Nothing here may live inside a Git checkout.
# All three are rendered into the quadlet by scripts/install.sh; the
# container mounts them with Mount=type=bind, which fails loudly on a
# missing source.

# Holds unsloth/Qwen3.6-27B-MTP-GGUF/Qwen3.6-27B-UD-Q4_K_XL.gguf, ~17.9 GB.
EDGE_MODEL_SOURCE=/home/<user>/.local/share/edge-bazzite/models

# Written by scripts/issue-edge-pki.sh: edge-ca.crt, edge-ca.key,
# edge-host.crt, edge-host.key. Keep it mode 0700.
EDGE_PKI_SOURCE=/home/<user>/.config/edge-bazzite/pki

# Holds one file, `api-key`, mode 0600: the per-node inference bearer
# credential, whose copy of record is the 1Password item
# op://Automation/edge-bazzite-5090/credential. On this node the host
# daemons read the SAME file (the units point EDGE_API_KEY_FILE into this
# directory), so there is exactly one on-disk copy.
EDGE_SECRETS_SOURCE=/home/<user>/.config/edge-bazzite/secrets

# The one directory the container's supervisor, the host-side guard and the
# host-side heartbeat all share: interactive-claim, guard-lease, phase and
# cache-manifest.json live in it. Must be the path the systemd units resolve
# %S/edge-bazzite-state to:
#
#   echo "${XDG_STATE_HOME:-$HOME/.local/state}/edge-bazzite-state"
#
# systemd creates and owns it; the quadlet bind-mounts it at /edge/state.
EDGE_STATE_HOST_DIR=/home/<user>/.local/state/edge-bazzite-state

# Where scripts/install.sh copies the runtime scripts and llama-swap.yaml,
# and what the quadlet mounts them from. Always $HOME/.local/libexec/
# edge-bazzite — fixed, because the units' ExecStart= hardcodes the same
# path and systemd specifiers cannot read arbitrary environment variables.
EDGE_LIBEXEC_DIR=/home/<user>/.local/libexec/edge-bazzite

# --- paths the HOST-SIDE daemons use ----------------------------------------

# Trust anchor for the daemons' calls to llama-swap. Verification stays on
# for them exactly as it does for conformance.sh. This is the public half of
# the PKI directory above.
EDGE_CA_CERT=/home/<user>/.config/edge-bazzite/pki/edge-ca.crt

# How stale a cache-observation manifest may be before edge-heartbeat.sh
# stops trusting it and reports cached_models empty. 3x the container's
# EDGE_CACHE_SCAN_INTERVAL below.
EDGE_CACHE_MANIFEST_MAX_AGE=180

# Same interim as conformance.sh's --resolve: until the unifi-dns DNSEndpoint
# for the edge hostname exists, the host-side daemons need to be told where
# the name points. Delete this line once the record exists. Never replace it
# with a validation bypass. RFC 5737 placeholder address.
EDGE_CURL_RESOLVE=bazzite-5090.homelab0.org:8443:192.0.2.10

# EDGE_STATE_DIR and EDGE_API_KEY_FILE are deliberately NOT set here. Each
# names a path that is different on the two sides of the container boundary,
# so a single value in this file would have to be wrong for one of them —
# and systemd applies EnvironmentFile= after Environment= whatever the order
# in a unit, so a value here would silently override the units. The quadlet
# states the container's (/edge/state, /edge/secrets/api-key) and the systemd
# units state the host's (%S/edge-bazzite-state,
# %h/.config/edge-bazzite/secrets/api-key).

# --- heartbeat --------------------------------------------------------------

# The router declares a node OFFLINE after 3 x interval, so this number has
# to match what the router is configured with.
EDGE_HEARTBEAT_INTERVAL=30

# https://agent-router.homelab0.org — leave empty and the producer prints the
# payload instead of posting it. Set it only once the router credential
# (below) is seeded, or every heartbeat is a logged 401.
EDGE_ROUTER_URL=

# EDGE_ROUTER_TOKEN stays EMPTY here, deliberately, and always will: this
# file's contract is that it is non-secret. The real value lives in a
# dedicated mode-0600 file, ~/.config/edge-bazzite/router.env, loaded by a
# systemd drop-in on edge-heartbeat.service alone (systemd/
# edge-heartbeat.service.d/router-token.conf). Its copy of record is
# op://Automation/edge-bazzite-5090/router-credential — a DIFFERENT
# credential and a different authority from the inference bearer above
# (capacity reporting TO the router, not traffic INTO this node). Never
# reuse one for the other.
EDGE_ROUTER_TOKEN=

# Until EDGE_ROUTER_URL is set, cluster_reachable is answered by an
# unauthenticated probe of the router's LAN hostname (any HTTP response
# proves reachability; 401 is expected and fine).
EDGE_CLUSTER_PROBE_URL=https://agent-router.homelab0.org/v1/status

# --- interactive priority ---------------------------------------------------

# Idle desktop VRAM in MB, measured on this host with the model unloaded:
#   nvidia-smi --query-gpu=memory.used --format=csv
# Measured 2026-08-24 at ~1417 MiB with the normal desktop session (Steam
# client, browser, terminals) open; 1500 leaves margin for ordinary drift.
# Re-measure after a desktop-environment change; it is the only calibrated
# number in the guard.
EDGE_DESKTOP_BASELINE_MB=1500

# Foreign VRAM above that baseline which counts as "a human wants the GPU".
# The 32 GB card leaves ~12 GB free with the model loaded, so unlike the
# CachyOS node this threshold is not squeezed by headroom; 2048 clears
# browser/video fluctuation while any real game blows straight past it.
EDGE_INTERACTIVE_VRAM_MB=2048

# Per-process VRAM floor above which a single foreign compute client trips
# the guard on its own (rule 2). Idle desktop clients measure 77-250 MiB
# each on this host.
EDGE_FOREIGN_COMPUTE_MB=1024

# GPU busy-% that counts as someone else's work when llama-swap verifiably
# has nothing loaded. Desktop idle measures 3-5%.
EDGE_INTERACTIVE_GPU_PCT=25

# Sampling. Detection latency is roughly INTERVAL x TRIP_SAMPLES; the release
# hold-down is INTERVAL x RELEASE_SAMPLES and is deliberately much longer, so
# a pause between two rounds of a game does not put the node back in service.
EDGE_GUARD_INTERVAL=2
EDGE_GUARD_TRIP_SAMPLES=3
EDGE_GUARD_RELEASE_SAMPLES=30

# Dedicated --max-time bound for the guard's OWN /running query — never the
# general EDGE_HTTP_TIMEOUT. The guard refuses to start `watch` if this plus
# two INTERVALs is not strictly below EDGE_GUARD_LEASE_TTL.
EDGE_GUARD_RUNNING_TIMEOUT=1

# Busy-% at which a loaded model is reported as SERVING rather than AVAILABLE.
EDGE_SERVING_GPU_PCT=20

# --- guard-ready lease (fail-closed interlock) ------------------------------

# Seconds a guard-liveness lease stays fresh before the supervisor withdraws
# the listener regardless of interactive-claim. Three times
# EDGE_GUARD_INTERVAL; read by the container (rendered into the quadlet),
# which is what actually enforces it.
EDGE_GUARD_LEASE_TTL=6

# --- cache-observation manifest ---------------------------------------------

# Seconds between the supervisor's rescans of /models for the manifest
# edge-heartbeat.sh derives cached_models from. Keep at 1/3 of
# EDGE_CACHE_MANIFEST_MAX_AGE above.
EDGE_CACHE_SCAN_INTERVAL=60

# --- GPU sensor -------------------------------------------------------------

# Absolute path to nvidia-smi. MUST be absolute (STORY-035-6a cycle 5,
# inherited): a bare name resolves through PATH, and the systemd user
# manager's boot-time PATH is not a login shell's. scripts/install.sh
# refuses to install if this is not an existing executable file. Since the
# lease is renewed only on a valid sample, a wrong value here withdraws
# service within one EDGE_GUARD_LEASE_TTL instead of running blind.
NVIDIA_SMI=/usr/bin/nvidia-smi

# cgroup substring that marks the edge container's own processes (how the
# guard tells our llama-server from foreign GPU work — see edge-common.sh).
# The quadlet-generated unit name; change only if the container is renamed.
EDGE_OUR_CGROUP_TAG=edge-llama-swap.service
